+/* 2.1.1 - The pill-shaped radio/checkbox groups hid the real control with
+   display:none, which removes it from the tab order entirely. Hide it
+   visually but keep it focusable, and paint the focus ring on the label the
+   user actually sees. */
+.group_btn input[type="radio"] {
+  display: block !important;
+  position: absolute !important;
+  width: 1px !important;
+  height: 1px !important;
+  margin: 0 !important;
+  padding: 0 !important;
+  opacity: 0 !important;
+  pointer-events: none;
+}
+
+.group_btn input[type="radio"]:focus-visible + .form-check-label,
+.group_btn input[type="radio"]:focus-visible + label,
+.group_btn input[type="checkbox"]:focus-visible + .form-check-label,
+.group_btn input[type="checkbox"]:focus-visible + label {
+  outline: 3px solid #005fcc !important;
+  outline-offset: 2px !important;
+}
+
+/* Keyboard users get no hover cue, so make the checked pill unmistakable. */
+.group_btn input[type="radio"]:focus-visible + .form-check-label,
+.group_btn input[type="checkbox"]:focus-visible + .form-check-label {
+  box-shadow: 0 0 0 1px #005fcc inset;
+}
+
+/* 1.4.11 - checkbox and radio borders were #DEE2E6 on white (1.3:1). */
+.form-check-input {
+  border-color: #8896a5 !important;
+}
+
+.form-check-input:checked {
+  border-color: #280071 !important;
+}
+
+/* 1.4.11 - focus ring on native check controls. */
+.form-check-input:focus-visible {
+  outline: 3px solid #005fcc !important;
+  outline-offset: 2px !important;
+  box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 1) !important;
+}
+
+/* 1.4.3 - placeholder text was #7D7D7D on white (4.1:1). */
+::placeholder {
+  color: #767676 !important;
+  opacity: 1;
+}
+
+input::-webkit-input-placeholder,
+textarea::-webkit-input-placeholder {
+  color: #767676 !important;
+}
+
+/* 1.4.11 - form control borders were #9E9FA7 on white (2.6:1). */
+input[type="text"].form-control,
+input[type="date"].form-control,
+input[type="password"].form-control,
+input[type="email"].form-control,
+input[type="tel"].form-control,
+input[type="number"].form-control,
+select.form-select,
+textarea.form-control {
+  border-color: #898994 !important;
+}
+
+/* 1.4.11 - PrimeNG autocomplete highlighted the active option with a
+   #DEE2E6 fill (1.3:1 against white). Use an outline instead. */
+.p-autocomplete-item.p-focus,
+.p-autocomplete-item:focus,
+.p-autocomplete-item.p-highlight {
+  background: #fff !important;
+  color: #2b2b2b !important;
+  outline: 3px solid #005fcc !important;
+  outline-offset: -3px !important;
+}
+
+/* 1.4.3 - spinner copy was #280071 on the #5B5B5C scrim (2.3:1). */
+.ngx-spinner-overlay p,
+ngx-spinner p {
+  color: #ddcaff !important;
+  font-weight: 600;
+}
+
+/* 1.4.1 - inline actions rendered as links must not rely on colour alone. */
+.mobile_box a,
+.email_text_section a {
+  text-decoration: underline !important;
+}
+
+.mobile_box a:focus-visible,
+.email_text_section a:focus-visible {
+  outline: 3px solid #005fcc !important;
+  outline-offset: 4px !important;
+}
+
+/* Visually hidden helper for status messages and off-screen headings. */
+.visually-hidden,
+.sr-only {
+  position: absolute !important;
+  width: 1px !important;
+  height: 1px !important;
+  padding: 0 !important;
+  margin: -1px !important;
+  overflow: hidden !important;
+  clip: rect(0, 0, 0, 0) !important;
+  white-space: nowrap !important;
+  border: 0 !important;
+}
+
+/* 1.4.10 - nothing may be lost at a 320px x 256px viewport (400% of
+   1280x1024). Modals and the sticky footers were clipping there. */
+@media screen and (max-width: 400px), screen and (max-height: 450px) {
+  .modal-dialog {
+    max-width: 100%;
+    margin: 0.5rem;
+  }
+
+  .modal-content {
+    max-height: 96vh;
+    overflow-y: auto;
+  }
+
+  .modal-body {
+    max-height: none;
+    overflow-y: auto;
+  }
+}
+
+/* 3.3.2 - required fields need a visible marker plus an up-front instruction,
+   not just a placeholder that vanishes on the first keystroke. */
+.required-note {
+  font-size: 12px;
+  color: #595959;
+  font-weight: 500;
+  margin: 0 0 8px 0;
+}
+
+.req-star,
+.required-note span[aria-hidden="true"] {
+  color: #c60000;
+}
+
+/* ==========================================================================
+   1.4.10 Reflow - at 400% zoom on a 1280x1024 display the viewport is only
+   320x256 CSS pixels. Content must not be clipped or lost there.
+   The short-viewport queries below deliberately key off height, so that a
+   zoomed desktop is caught while a portrait phone keeps its own layout.
+   ========================================================================== */
+@media screen and (max-width: 400px), screen and (max-height: 450px) {
+  /* Sticky footers steal most of a 256px-tall viewport and cover the content
+     underneath, so let them scroll with the page instead. */
+  .stickybtn,
+  .stickybtn_desk {
+    position: static !important;
+  }
+
+  /* Cards and carousels sized in fixed pixels overflow the viewport. */
+  .plan_cards,
+  .plan-wrapper,
+  .card_cls,
+  .p-carousel-item,
+  .p-carousel-items-container {
+    max-width: 100% !important;
+    min-width: 0 !important;
+  }
+
+  .p-carousel-content {
+    overflow: visible !important;
+  }
+}
+
+@media screen and (max-height: 450px) {
+  /* The "No webcam? Continue with mobile" panel is hidden below 767px, which
+     also hides it from a zoomed desktop and loses the alternative path. */
+  .pan_details_form .mobile_box {
+    display: block !important;
+  }
+}
+
+/* 2.1.1 / 2.4.7 - the "Upload Image" and "Re-Upload Image" controls are file
+   inputs hidden with display:none inside a styled <label>, which drops them out
+   of the tab order entirely. Hide them visually instead, and surface focus on
+   the label the user actually sees. */
+label.btn,
+label.btn_cls,
+label.btn_cls_outline {
+  position: relative;
+}
+
+label.btn input[type="file"],
+label.btn_cls input[type="file"],
+label.btn_cls_outline input[type="file"] {
+  display: block !important;
+  position: absolute !important;
+  left: 0;
+  top: 0;
+  width: 1px !important;
+  height: 1px !important;
+  opacity: 0 !important;
+}
+
+label.btn:focus-within,
+label.btn_cls:focus-within,
+label.btn_cls_outline:focus-within {
+  outline: 3px solid #005fcc !important;
+  outline-offset: 2px !important;
+}
+
+/* 2.4.7 - the camera / upload tiles stack a transparent file input over an
+   icon, so its own focus ring is invisible. Draw the ring on the tile. */
+.img_upload > div:focus-within,
+.img_upload .camera_icon:focus-within {
+  outline: 3px solid #005fcc;
+  outline-offset: 4px;
+  border-radius: 8px;
+}
+
+/* 2.5.7 / 2.4.7 - the crop frame is keyboard-operable (arrow keys move and
+   resize it) but its focus ring was invisible, so nobody found it. */
+.ngx-ic-cropper:focus,
+.ngx-ic-cropper:focus-visible {
+  outline: 3px solid #005fcc !important;
+  outline-offset: 2px !important;
+}
+
+.cropper_hint {
+  font-size: 12px;
+  color: #595959;
+  margin-top: 8px;
+  text-align: left;
+}
+
+/* 1.4.3 - toast copy is white, but ngx-toastr's default fills give it only
+   2.3:1 (warning), 3.4:1 (info) and 3.0:1 (success). These need !important
+   because toastr.css is bundled after this file. */
+.toast-warning {
+  background-color: #a76202 !important;
+}
+
+.toast-info {
+  background-color: #28809a !important;
+}
+
+.toast-success {
+  background-color: #2e7031 !important;
+}
+
+.toast-error {
+  background-color: #b3271f !important;
+}
